{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "experimental": {
    "subagent_depth": 2
  },
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:git push --force*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push * --force*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push -f *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push * -f *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push --delete *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push * --delete *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git clean *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git branch -D *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git worktree remove --force *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git worktree remove * --force *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git worktree remove -f *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git worktree remove * -f *",
      "effect": "deny"
    }
  ],
  "plugins": [
    "./extensions/worker-alarm"
  ],
  "providers": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": {
            "context": 480000,
            "output": 32000
          },
          "body": {
            "provider": {
              "order": [
                "Sail Research",
                "Wafer",
                "DeepInfra",
                "StepFun"
              ],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "title": {
      "model": "openai/gpt-6-luna"
    },
    "summary": {
      "model": "openai/gpt-6-luna"
    },
    "compaction": {
      "model": "openai/gpt-6.1-terra"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "70%"
  }
}
